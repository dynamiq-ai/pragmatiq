# CPU overlay for deploy/triton/model_repository/pragmatiq_embedder/config.pbtxt.
# Identical contract (python backend, in-model batching, records_json -> embeddings);
# only the instance group differs: KIND_CPU so tritonserver boots on a host without
# GPUs. Mounted over the default config by scripts/deploy_serving.sh (no nvidia-smi)
# and deploy/docker-compose.cpu.yaml.
name: "pragmatiq_embedder"
backend: "python"
max_batch_size: 0

input [
  {
    name: "records_json"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]
output [
  {
    name: "embeddings"
    data_type: TYPE_FP32
    dims: [ -1, -1 ]   # [n_users, dim]
  }
]

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

parameters [
  {
    key: "run_dir"
    value: { string_value: "/models/run" }
  }
]
